{
  "scenario": "s02_prod_hotfix_vs_dev_fix",
  "description": "Core case. prod got a hotfix on the same line a dev fix changes. Backporting the dev fix to prod conflicts.",
  "reproduce": [
    "git checkout prod",
    "git cherry-pick -x b869bc07a4661451ffb491c1e2dce32adcc04286"
  ],
  "commits": {
