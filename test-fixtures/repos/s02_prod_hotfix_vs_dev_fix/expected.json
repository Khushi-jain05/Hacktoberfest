    "dev_fix": "b869bc07a4661451ffb491c1e2dce32adcc04286"
  },
  "expected": {
    "conflict": true,
    "files": [
      "app/payment.py"
    ],
    "hunks": 1,
    "ours": {
      "branch": "prod",
      "origin_commit": "92f89fc201d78f92d18cc374d30c97916b5d7daa",
      "status": "production-tested",
      "evidence": [
        "test:production:pass",
        "deploy:production"
      ]
    },
    "theirs": {
      "branch": "dev",
      "origin_commit": "b869bc07a4661451ffb491c1e2dce32adcc04286",
      "status": "tested-in-dev-only",
      "evidence": [
        "test:dev:pass"
      ]
    },
    "must_not": [
