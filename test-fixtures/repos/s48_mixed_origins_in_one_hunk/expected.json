    "prod_undeployed_line": "db99eb8c8a9c498ea199f108d9186614fa954e19",
    "dev_fix": "d37370772ac4577a88ce4a3f1d4a2a486f97380c"
  },
  "expected": {
    "ours": {
      "origin_commits": [
        "92f89fc201d78f92d18cc374d30c97916b5d7daa",
        "db99eb8c8a9c498ea199f108d9186614fa954e19"
      ],
      "status": "unverified (weakest line wins)"
