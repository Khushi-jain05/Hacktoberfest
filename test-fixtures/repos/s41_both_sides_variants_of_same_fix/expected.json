{
  "scenario": "s41_both_sides_variants_of_same_fix",
  "description": "The SAME dev fix was hand-backported twice, differently, to uat and prod. Merging uat into prod makes the two variants of one fix conflict with each other.",
  "reproduce": [
    "git checkout prod",
    "git merge uat"
  ],
  "commits": {
    "base": "ef9c2cea78f5f1e7cab6d815c67062e6cb1a2b0d",
    "dev_original": "6dc2818c7022446bee25e5ba5ef87e7524320e4b",
    "uat_variant": "10f5aee88ad85ac2acc56ea12e53394a5ed23cb7",
    "prod_variant": "776870d92fbfa712b3aa5a9107cb5f28c5527054"
  },
  "expected": {
    "ours": {
      "origin_commit": "776870d92fbfa712b3aa5a9107cb5f28c5527054",
      "status": "production",
      "variant_of": "6dc2818c7022446bee25e5ba5ef87e7524320e4b"
    },
    "theirs": {
      "origin_commit": "10f5aee88ad85ac2acc56ea12e53394a5ed23cb7",
      "status": "uat",
      "variant_of": "6dc2818c7022446bee25e5ba5ef87e7524320e4b"
    },
    "should_explain": "both sides are versions of the same fix; prod's version is the one running"
  }
}
