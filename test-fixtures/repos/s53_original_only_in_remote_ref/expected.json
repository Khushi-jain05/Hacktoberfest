    "prod_copy": "92dbbb50cd07ca08894fe63ec834b6196724040c"
  },
  "expected": {
    "match": {
      "backport": "92dbbb50cd07ca08894fe63ec834b6196724040c",
      "original": "32d47f3211332467950dd506419c066fd0bb9647",
      "exact": true
    },
    "must": [
      "search all refs (git log --all / for-each-ref), not just local branches"
    ]
  }
}
